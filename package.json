{
  "name": "dsh-douyin-whale",
  "version": "1.3.1",
  "description": "Douyin toolkit for Dafeiyu (大肥鱼): hot list, search, video frames, guarded DM/group, local HTTP API.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "python/*.py",
    "python/requirements.txt",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples/*.yml",
    "scripts"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "douyin",
    "dafeiyu",
    "whale",
    "dy-cli",
    "playwright",
    "douyin-im",
    "http-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackey670/dsh-douyin-whale.git"
  },
  "homepage": "https://github.com/jackey670/dsh-douyin-whale",
  "bugs": {
    "url": "https://github.com/jackey670/dsh-douyin-whale/issues"
  },

  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check lib/backend.js && node --check lib/tools.js && node --check lib/normalize.js && node --check lib/douyin_http_client.mjs && node --check douyin.mjs",
    "http": "python python/douyin_http.py",
    "douyin": "node douyin.mjs",
    "test:fixture": "python tests/test_fixture.py",
    "test:safety": "python -m pytest -q tests/test_safety.py"
  }
}
