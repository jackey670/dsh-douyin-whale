{
  "name": "dsh-douyin-whale",
  "version": "1.4.0",
  "description": "Douyin toolkit for Dafeiyu (大肥鱼): hot list, search, video frames, native share cards, guarded DM, local HTTP API, and a scheduler that watches the owner-sent videos and replies.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "douyin.mjs",
    "scheduler/*.mjs",
    "scheduler/tools-deny.txt",
    "scheduler/agent/AGENTS.md",
    "start-whale.cmd",
    "start-whale.vbs",
    "python/*.py",
    "python/requirements.txt",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples/*.yml",
    "scripts",
    "tools/*.py",
    "tools/*.mjs",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "douyin",
    "dafeiyu",
    "whale",
    "dy-cli",
    "playwright",
    "douyin-im",
    "http-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackey670/dsh-douyin-whale.git"
  },
  "homepage": "https://github.com/jackey670/dsh-douyin-whale",
  "bugs": {
    "url": "https://github.com/jackey670/dsh-douyin-whale/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/backend.js && node --check lib/tools.js && node --check lib/normalize.js && node --check lib/douyin_http_client.mjs && node --check lib/whale_state.js && node --check lib/panel_api.js && node --check douyin.mjs && node --check scheduler/scheduler.mjs && node --check scheduler/memory.mjs",
    "http": "python python/douyin_http.py",
    "douyin": "node douyin.mjs",
    "test:fixture": "node tools/run-py.mjs tests/test_fixture.py",
    "test:safety": "node tools/run-py.mjs -m pytest -q tests/test_safety.py",
    "test:readback": "node tools/run-py.mjs -m pytest -q tests/test_readback.py",
    "test": "npm run test:py && node scheduler/memory.test.mjs && node lib/panel.test.mjs && node lib/panel_api.test.mjs && node lib/duty_agent.test.mjs && node lib/whale_tick.test.mjs",
    "test:memory": "node scheduler/memory.test.mjs",
    "test:js": "node scheduler/memory.test.mjs",
    "test:panel": "node lib/panel.test.mjs",
    "test:api": "node lib/panel_api.test.mjs",
    "preview": "node tools/panel-preview/server.mjs",
    "test:py": "node tools/run-py.mjs -m pytest -q tests/test_safety.py tests/test_readback.py tests/test_send_gate.py",
    "test:send-gate": "node tools/run-py.mjs -m pytest -q tests/test_send_gate.py",
    "test:tick": "node lib/whale_tick.test.mjs",
    "test:duty": "node lib/duty_agent.test.mjs"
  }
}
